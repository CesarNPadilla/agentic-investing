    "evidence_class": {
      "const": "SYNTHETIC_ONLY",
      "default": "SYNTHETIC_ONLY",
      "title": "Evidence Class",
      "type": "string"
    },
    "initial_funded_sleeve": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Initial Funded Sleeve"
    },
    "current_flow_adjusted_equity": {
