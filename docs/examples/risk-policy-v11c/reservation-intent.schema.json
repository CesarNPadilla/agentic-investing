{
  "additionalProperties": false,
  "properties": {
    "evidence_class": {
      "const": "SYNTHETIC_ONLY",
      "default": "SYNTHETIC_ONLY",
      "title": "Evidence Class",
      "type": "string"
    },
    "proposal_id": {
      "minLength": 1,
      "title": "Proposal Id",
      "type": "string"
    },
    "proposal_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Digest",
      "type": "string"
    },
    "amount": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Amount"
    }
  },
  "required": [
    "proposal_id",
    "proposal_digest",
    "amount"
  ],
  "title": "ReservationIntent",
  "type": "object"
}
