{
  "$defs": {
    "Article": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "headline": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "publisher": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "symbols": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9.\\-]{0,14}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Symbols",
          "type": "array"
        }
      },
      "required": [
        "id",
        "headline",
        "url",
        "publisher",
        "published_at",
        "symbols"
      ],
      "title": "Article",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "description": "Reviewed configuration, never populated from publisher instructions.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "basis": {
          "enum": [
            "quarter",
            "annual",
            "ttm",
            "point_in_time",
            "forward"
          ],
          "title": "Basis",
          "type": "string"
        },
        "operator": {
          "enum": [
            "ge",
            "le"
          ],
          "title": "Operator",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Threshold"
        },
        "invalidates_when_false": {
          "default": false,
          "title": "Invalidates When False",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "metric",
        "unit",
        "basis",
        "operator",
        "threshold"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Catalyst": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "category": {
          "enum": [
            "earnings",
            "product",
            "regulatory",
            "corporate_action",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "event_at": {
          "format": "date-time",
          "title": "Event At",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "certainty": {
          "default": "estimated",
          "enum": [
            "confirmed",
            "estimated"
          ],
          "title": "Certainty",
          "type": "string"
        }
      },
      "required": [
        "title",
        "category",
        "event_at",
        "evidence_id"
      ],
      "title": "Catalyst",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_references": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence References",
          "type": "array"
        },
        "kind": {
          "default": "interpretation",
          "enum": [
            "fact",
            "interpretation"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence_references"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Freshness": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "CURRENT",
            "LATEST_REPORTED",
            "HISTORICAL",
            "STALE",
            "UNAVAILABLE"
          ],
          "title": "State",
          "type": "string"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "state"
      ],
      "title": "Freshness",
      "type": "object"
    },
    "FundamentalData": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,14}$",
          "title": "Symbol",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "metrics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "claims": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Claim"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "business_summary",
              "investment_thesis",
              "positive_drivers",
              "negative_drivers",
              "catalysts",
              "risks",
              "invalidation_conditions",
              "financial_health",
              "growth_context",
              "profitability_context",
              "competitive_position",
              "ai_exposure",
              "cash_generation"
            ]
          },
          "title": "Claims",
          "type": "object"
        }
      },
      "required": [
        "symbol",
        "retrieved_at"
      ],
      "title": "FundamentalData",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "basis": {
          "enum": [
            "quarter",
            "annual",
            "ttm",
            "point_in_time",
            "forward"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "source_id",
        "period_start",
        "period_end",
        "basis"
      ],
      "title": "Metric",
      "type": "object"
    },
    "NewsEvidence": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,14}$",
          "title": "Symbol",
          "type": "string"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        },
        "is_sample": {
          "default": false,
          "title": "Is Sample",
          "type": "boolean"
        },
        "articles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Article"
          },
          "maxItems": 200,
          "title": "Articles",
          "type": "array"
        },
        "catalysts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Catalyst"
          },
          "maxItems": 100,
          "title": "Catalysts",
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "source",
        "retrieved_at",
        "window_start"
      ],
      "title": "NewsEvidence",
      "type": "object"
    },
    "PortfolioContext": {
      "additionalProperties": false,
