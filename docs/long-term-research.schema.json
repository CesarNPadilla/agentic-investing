        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "actual_symbols": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9.\\-]{0,14}$",
            "type": "string"
          },
          "title": "Actual Symbols",
          "type": "array"
        },
        "current_allocation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Allocation"
        },
        "current_market_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Market Value"
        },
        "cost_basis": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Basis"
        },
        "unrealized_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unrealized Pnl"
        },
        "classifications": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Classifications",
          "type": "array"
        },
        "concentration_flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Concentration Flags",
          "type": "array"
        },
        "data_gaps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Data Gaps",
          "type": "array"
        },
        "portfolio_overlap": {
          "default": "Direct holdings only; ETF look-through unknown",
          "title": "Portfolio Overlap",
          "type": "string"
        },
        "diversification_impact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diversification Impact"
        }
      },
      "required": [
        "observation_id",
        "as_of",
        "actual_symbols"
      ],
      "title": "PortfolioContext",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,14}$",
          "title": "Symbol",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Price"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "is_sample": {
          "title": "Is Sample",
          "type": "boolean"
        }
      },
      "required": [
        "symbol",
        "price",
        "currency",
        "as_of",
        "source",
        "is_sample"
      ],
      "title": "Quote",
      "type": "object"
    },
    "ResearchPlan": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,14}$",
          "title": "Symbol",
          "type": "string"
        },
        "reviewed_by": {
          "minLength": 1,
          "title": "Reviewed By",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "thesis": {
          "minLength": 1,
          "title": "Thesis",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "minItems": 1,
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "plan_id",
        "symbol",
        "reviewed_by",
        "reviewed_at",
        "thesis",
        "assumptions"
      ],
      "title": "ResearchPlan",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,14}$",
          "title": "Symbol",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "sec",
            "investor_relations",
            "earnings_release",
            "market_data",
            "news",
            "other"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "period_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Start"
        },
        "period_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period End"
        },
        "relevant_claim": {
          "minLength": 1,
          "title": "Relevant Claim",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "reliable": {
          "default": false,
          "title": "Reliable",
          "type": "boolean"
        },
        "is_sample": {
          "default": false,
          "title": "Is Sample",
          "type": "boolean"
        },
        "historical": {
          "default": false,
          "title": "Historical",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "symbol",
        "source",
        "source_type",
        "published_at",
        "retrieved_at",
        "relevant_claim"
      ],
      "title": "Source",
      "type": "object"
    },
    "ValuationContext": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "INSUFFICIENT_DATA",
