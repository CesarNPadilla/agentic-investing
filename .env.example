# Research-only defaults; no brokerage or LLM credentials required.
AIL_MODE=research
AIL_MARKET_PROVIDER=sample
AIL_LLM_PROVIDER=disabled
# Local fallback. Docker Compose overrides this with PostgreSQL.
AIL_DATABASE_URL=sqlite:///./research.db
# Docker Compose only: set a local database password before startup.
POSTGRES_PASSWORD=
